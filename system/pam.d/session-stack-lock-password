# Password-only authentication worker for the Session Stack QuickShell lock.
# Biometrics run in separate workers so a correct password never waits for
# camera or fingerprint timeouts. This mirrors Arch's pam_faillock flow while
# deliberately excluding pam_fprintd and pam_howrs. Its dedicated tally keeps
# lock-screen failures from disabling sudo or TTY recovery.

auth        required                    pam_faillock.so      preauth conf=/etc/security/session-stack-faillock.conf
auth        [success=1 default=bad]     pam_unix.so          try_first_pass
auth        [default=die]               pam_faillock.so      authfail conf=/etc/security/session-stack-faillock.conf
auth        optional                    pam_permit.so
auth        required                    pam_env.so
auth        required                    pam_faillock.so      authsucc conf=/etc/security/session-stack-faillock.conf
